# 営業リスト自動化 — 環境変数テンプレート
# 本ファイルをコピーして .env を作成し、値を入れてください。
# .env は .gitignore 対象のため git 管理されません。

# ---- STEP 1 以降で必須 ----
# Serper API (Google Maps 検索). https://serper.dev で発行
SERPER_API_KEY=your-serper-api-key

# ---- STEP 7 以降 (Slack 承認) で必要 ----
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_CHANNEL_ID=C0123456789

# ---- STEP 8 以降 (メール送信) で必要 ----
# 送信方式 (smtp / sendgrid)
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=
# FROM_NAME=
# SENDGRID_API_KEY=
